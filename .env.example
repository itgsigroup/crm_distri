# ARC — environment settings. Copy to .env and fill in. Never commit .env.
# Empty credentials = the connector runs with its mock (stage "done-with-mocks").

# ---------- Core ----------
ARC_ENV=development                 # development | staging | production
ARC_ADDR=:8000                      # API listen address
ARC_PUBLIC_URL=http://localhost:8000 # public base URL (OAuth/MCP metadata, cookies Secure when https)
ARC_WEB_DIST=apps/web/dist          # built React app served by the API in production
DATABASE_URL=postgres://arc:arc@localhost:5433/arc?sslmode=disable
ARC_ENCRYPTION_KEY=change-me-32-bytes-encryption-key   # encrypts OAuth tokens at rest (AES-GCM)
ARC_SCHEDULER=on                    # on | off — hourly jobs, daily 06:30, briefs 06:45/16:00 WIB
ARC_DAILY_COST_ALERT_IDR=150000     # LLM cost per day that triggers an alert to the CEO
# Demo clock: pin "now" to the mockup date so seeded fixtures look current. Leave empty in production.
ARC_CLOCK_ANCHOR=2026-09-28T17:02:00+07:00

# ---------- LLM (ADR 0001 §provider abstraction) ----------
ARC_LLM_PROVIDER=auto               # auto | anthropic | openai | ollama | fake (auto = anthropic if key, else fake)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                     # optional fallback provider
OLLAMA_URL=                         # optional local provider, e.g. http://localhost:11434
ARC_MODEL_LIGHT=claude-haiku-4-5
ARC_MODEL_HEAVY=claude-sonnet-5
ARC_MODEL_INTERACTIVE=claude-sonnet-5
ARC_MODEL_FALLBACK=openai

# ---------- WhatsApp ----------
# Transport A: apps/wa-bridge (Node + Baileys, linked device via QR; groups + history)
BRIDGE_URL=http://localhost:3001
BRIDGE_SECRET=change-me-bridge-secret   # shared HMAC secret API <-> bridge (required in production, ≥ 16 chars)
BRIDGE_PORT=3001
ARC_API_URL=http://localhost:8000       # where the bridge forwards events
BRIDGE_DATABASE_URL=                    # default: DATABASE_URL (bridge uses schema wa_bridge)
BRIDGE_DATA_DIR=./data                  # offline event queue
BRIDGE_LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn
# Anti-ban policy (ADR 0004). Defaults are conservative — loosen only with a reason.
BRIDGE_MAX_SEND_PER_HOUR=20             # per number, sliding hour
BRIDGE_MAX_SEND_PER_DAY=120             # per number, per day (WIB)
BRIDGE_MAX_SEND_PER_CHAT_HOUR=6         # to one chat per hour
BRIDGE_MIN_GAP_SAME_CHAT_SEC=20         # spacing between two messages to the same chat
BRIDGE_WARMUP_DAYS=7                    # after linking a number the daily cap ramps up over N days (0 = off)
BRIDGE_WARMUP_START_PER_DAY=15          # daily cap on the first day
BRIDGE_QUIET_START_HOUR=21              # no sends 21.00–07.00 WIB
BRIDGE_QUIET_END_HOUR=7
BRIDGE_REQUIRE_PRIOR_INBOUND=on         # only message chats that wrote to this number first (on|off)
BRIDGE_MAX_SAME_TEXT_CHATS=3            # same text to more chats per hour = broadcast → refused
BRIDGE_PROFILE_LOOKUPS_PER_HOUR=30      # WhatsApp profile queries per number per hour
# Transport B: WhatsApp Cloud API (official, 1:1 only)
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_APP_SECRET=
WA_CLOUD_VERIFY_TOKEN=arc-verify

# ---------- Identification (inbound numbers only) ----------
TRUECALLER_API_KEY=
WEB_SEARCH_API_KEY=

# ---------- Odoo (source of truth from stage 08) ----------
ODOO_URL=                            # e.g. https://gsi.odoo.com
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_COMPANY_IDS=                    # comma separated, e.g. 1,2

# ---------- Google Workspace (Gmail + Calendar, read + drafts) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/google/callback

# ---------- Notifications ----------
BASECAMP_TOKEN=
BASECAMP_ACCOUNT_ID=
BASECAMP_PROJECT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ARC <arc@gsi.co.id>
BRIEF_RECIPIENTS=ceo                 # role(s) or emails receiving the daily brief

# ---------- Tests ----------
ARC_TEST_DATABASE_URL=postgres://arc:arc@localhost:5433/arc_test?sslmode=disable
ARC_PERF_DATABASE_URL=postgres://arc:arc@localhost:5433/arc_perf?sslmode=disable   # make perf (wiped on each run)

# ---------- Docker Compose / Caddy ----------
POSTGRES_USER=arc
POSTGRES_PASSWORD=arc
POSTGRES_DB=arc
ARC_DOMAIN=localhost                 # Caddy site address (real domain → automatic HTTPS)
