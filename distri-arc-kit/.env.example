# Distri ARC Orbit — copy to .env and adjust. Secrets are never committed.

# --- runtime ---
APP_ENV=dev                         # dev | prod. dev enables X-Dev-User auth and ARC_NOW
API_ADDR=:8080
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173

# --- database (PostgreSQL 16+) ---
# Docker: make db-up → postgres://arc:arc@localhost:5432/distri_arc?sslmode=disable
DATABASE_URL=postgres://arc:arc@localhost:5432/distri_arc?sslmode=disable
DATABASE_URL_TEST=postgres://arc:arc@localhost:5432/distri_arc_test?sslmode=disable
DEV_DB=compose                      # compose | native (scripts/dev.sh skips Docker when native)

# --- clock (dev only) ---
# Pins "now" to the sample data's anchor so metrics match the approved mockup. Leave empty for real time.
ARC_NOW=2026-10-05T06:45:00+07:00

# --- web dev proxy ---
ARC_API_URL=http://localhost:8080
ARC_DEV_USER=sam@gsi.co.id          # user the dev proxy authenticates as (until stage 11 sessions)

# --- WhatsApp (stage 03) ---
WA_TRANSPORT=fake                  # fake | baileys (banyak nomor, ADR 0017) | whatsmeow | cloudapi (nomor bisnis resmi)
BRIDGE_URL=http://127.0.0.1:8111   # baileys: apps/wa-bridge (make bridge)
BRIDGE_SECRET=                     # baileys: HMAC bersama worker ↔ bridge, ≥ 16 karakter (openssl rand -hex 24)
BRIDGE_LISTEN=127.0.0.1:8112       # baileys: worker menerima event dari bridge di sini
BRIDGE_WORKER_URL=http://127.0.0.1:8112  # dibaca bridge: alamat worker
# Penjaga anti-blokir bridge (default konservatif; hanya dilonggarkan dengan sengaja, ADR 0017):
# BRIDGE_MAX_SEND_PER_HOUR=20 BRIDGE_MAX_SEND_PER_DAY=120 BRIDGE_MAX_SEND_PER_CHAT_HOUR=6 BRIDGE_MIN_GAP_SAME_CHAT_SEC=20
# BRIDGE_WARMUP_DAYS=7 BRIDGE_WARMUP_START_PER_DAY=15 BRIDGE_QUIET_START_HOUR=21 BRIDGE_QUIET_END_HOUR=7
# BRIDGE_REQUIRE_PRIOR_INBOUND=on BRIDGE_MAX_SAME_TEXT_CHATS=3 BRIDGE_PROFILE_LOOKUPS_PER_HOUR=30
WA_SEND_GAP=20s-90s                # jeda acak antar pesan proaktif satu nomor (dev fake: 0s-0s)
WA_REPLY_DELAY=2s-6s               # jeda mengetik untuk balasan manusia
WA_SEND_HOURS=08-18                # jendela kirim proaktif WIB; dev dengan ARC_NOW tetap 06.45: off
WA_BACKFILL_DAYS=30                # riwayat yang diimpor saat pairing (whatsmeow)
WA_CLOUD_NUMBER=                   # Cloud API: nomor bisnis (62…)
WA_CLOUD_PHONE_ID=
WA_CLOUD_TOKEN=
WA_CLOUD_VERIFY_TOKEN=
WA_CLOUD_APP_SECRET=

# --- Odoo (stage 04) — source of truth, read-only ---
ODOO_MODE=fake                     # fake (db/seed/odoo) | rpc | off
ODOO_URL=https://odoo.gsi.co.id
ODOO_DB=gsi
ODOO_USER=distri-arc@gsi.co.id     # read-only user
ODOO_API_KEY=
ODOO_WRITE=false                   # true: SO draft + catatan internal (message_post) ke Odoo; uji di instance test dulu

# --- LLM (stage 05) — agents write reasons & drafts; every number comes from internal/metrics ---
LLM_PROVIDER=fake                  # fake (deterministic templates) | anthropic
LLM_MODEL=                         # empty = policy llm.routing.model (claude-sonnet-5-5); e.g. claude-opus-5-5
ANTHROPIC_API_KEY=                 # or an `ant auth login` profile
OPENAI_API_KEY=                    # optional backup (policy llm.routing.fallback = openai:<model>)
LLM_IDR_PER_USD=16500              # exchange rate for llm_calls.cost_idr estimates

# --- MCP (stage 07) — Distri ARC as MCP server at <PUBLIC_URL>/mcp (tokens: arc ctl mcp-token) ---
PUBLIC_URL=http://localhost:8080   # base URL shown in Pengaturan → Koneksi AI (prod: https://distri.gsi.co.id)

# --- Identifikasi nomor (stage 09) ---
TRUECALLER_API_KEY=                # kosong = adapter fake (identifikasi dari WA Business, Getcontact CSV, Odoo)

# --- Login & sesi (stage 11) ---
SESSION_SECRET=                    # ≥ 32 karakter acak, wajib di luar APP_ENV=dev (openssl rand -base64 48)
ARC_DEMO_PASSWORD=                 # dev saja: kata sandi akun contoh saat seed/reset (kosong = tidak ada)
# ARC_DEV_USER (di atas): kosongkan untuk menguji alur login di dev; cookie sesi selalu didahulukan

# --- Hardening & operasi (stage 13) — docs/DEPLOY.md, docs/RUNBOOK.md; periksa dengan `arc ctl check-env` ---
METRICS_TOKEN=                     # bearer untuk /metrics (Prometheus); kosong = hanya dari localhost
ALERT_WA_GROUP=                    # JID grup WhatsApp internal untuk alert (kosong = grup internal pertama)
ALERT_WA_FROM=                     # nomor pengirim alert (kosong = nomor tersambung pertama)
BACKUP_DIR=/var/backups/distri-arc # infra/backup.sh, harian 02.00 WIB, rotasi BACKUP_KEEP_DAYS
BACKUP_KEEP_DAYS=30
BACKUP_PASSPHRASE=                 # wajib di prod (openssl rand -hex 32) — atau BACKUP_AGE_RECIPIENT (age1…)
BACKUP_AGE_RECIPIENT=
BACKUP_RCLONE_REMOTE=              # opsional: salinan backup di luar server, mis. b2:gsi-backup/distri-arc
PG_BIN=                            # folder pg_dump/pg_restore bila versinya harus sama dengan server
OPENSSL=openssl                    # OpenSSL ≥ 1.1.1 / LibreSSL ≥ 3.3 (perlu -pbkdf2)

# --- docker-compose.prod.yml ---
DOMAIN=                            # mis. distri.gsi.co.id (Caddy, TLS otomatis)
ACME_EMAIL=it@gsi.co.id
POSTGRES_PASSWORD=                 # openssl rand -hex 24
VERSION=dev                        # tag image & versi di Status sistem
