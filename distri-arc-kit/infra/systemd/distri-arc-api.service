# Bare-metal alternative to docker-compose.prod.yml (docs/DEPLOY.md §B/§C): /var/www/crm_distri/bin/arc + /etc/distri-arc/env.
# Migrations run in infra/deploy.sh before the binary is switched.
[Unit]
Description=Distri ARC Orbit API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=arc
Group=arc
EnvironmentFile=/etc/distri-arc/env
ExecStart=/var/www/crm_distri/bin/arc api
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/distri-arc

[Install]
WantedBy=multi-user.target
