# ARC wa-bridge (whatsmeow). Device keys are stored in Postgres schema wa_bridge.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY apps/wa-bridge/go.mod apps/wa-bridge/go.sum ./
RUN go mod download
COPY apps/wa-bridge/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/wa-bridge .

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 bridge && mkdir -p /data && chown bridge /data
COPY --from=build /out/wa-bridge /usr/local/bin/wa-bridge
ENV TZ=Asia/Jakarta BRIDGE_PORT=3001 BRIDGE_DATA_DIR=/data
USER bridge
VOLUME /data
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:3001/health || exit 1
ENTRYPOINT ["/usr/local/bin/wa-bridge"]
