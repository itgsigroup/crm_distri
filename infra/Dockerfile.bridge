# ARC wa-bridge (Node + Baileys). Auth state lives in Postgres schema wa_bridge; /data holds the offline queue.
FROM node:22-alpine AS build
WORKDIR /src
COPY apps/wa-bridge/package*.json ./
RUN npm ci
COPY apps/wa-bridge/ ./
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine
RUN apk add --no-cache tzdata && mkdir -p /data && chown node /data
WORKDIR /app
COPY --from=build /src/node_modules ./node_modules
COPY --from=build /src/dist ./dist
COPY --from=build /src/package.json ./
ENV NODE_ENV=production TZ=Asia/Jakarta BRIDGE_PORT=3001 BRIDGE_DATA_DIR=/data
USER node
VOLUME /data
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:3001/health || exit 1
CMD ["node", "dist/main.js"]
