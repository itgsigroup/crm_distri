# ARC API: Go binary + built React app + fixtures/prompts/rules (read at runtime).
FROM node:22-alpine AS web
WORKDIR /src/apps/web
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM golang:1.26-alpine AS api
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY apps/api ./apps/api
COPY packages ./packages
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/arc ./apps/api/cmd/arc

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata postgresql17-client && adduser -D -u 10001 arc
WORKDIR /app
COPY --from=api /out/arc /app/bin/arc
COPY --from=web /src/apps/web/dist /app/apps/web/dist
COPY tests/fixtures /app/tests/fixtures
COPY tests/eval /app/tests/eval
COPY go.mod /app/go.mod
ENV TZ=Asia/Jakarta ARC_ADDR=:8000 ARC_WEB_DIST=apps/web/dist
USER arc
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:8000/health || exit 1
ENTRYPOINT ["/app/bin/arc"]
CMD ["serve"]
